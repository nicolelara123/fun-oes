<!DOCTYPE html>
<html lang= pt-BR">
head>
     <meta charset="UTF-8">
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
     <title>Jogo: Adivinhe o Número</title>
     <!-- Ligação com o arquivo CSS -->
     <link rel="stylesheet" href="../css/estilo.css">
 </head>
 <body>
     <div class="caixa-jogo">
         <h1>🔢 Adivinhe o Número Secreto!</h1>
         <p>Escolhi um número entre <strong>1 e 100</strong>.<br>Tente adivinhar qual é!</p>
         <input type="number" id="entradaNumero" placeholder="Digite seu palpite..." min="1" max="100">
         <button id="botaoAdivinhar">Adivinhar!</button>
         <div id="mensagem"></div>
         <button id="botaoReiniciar" class="escondido">🔄 Jogar Novamente</button>
     </div>
     <!-- Ligação com o arquivo JavaScript (nome que você usou: java.js) -->
     <script src="../java.js"></script>
 </body>
</html>
